# Copy this file to backend/.env for local dev (never commit the real .env).
# See the root README for how to obtain each value.

# --- Required to boot at all ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json

# --- Required for the frontend to be allowed to call the API ---
ALLOWED_ORIGIN=http://localhost:5173

# --- Required for series-follow / release-date lookups (app boots without it, but
#     series search and the daily release-check job will no-op with a logged warning) ---
HARDCOVER_API_KEY=your-hardcover-api-key

# --- Required for web push notifications (app boots without it, but subscribing to
#     push and sending notifications will fail until set) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional ---
PORT=8080
SERIES_CACHE_TTL_HOURS=24
