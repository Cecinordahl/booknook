# Copy this file to frontend/.env.local for local dev (never commit the real one).
# See the root README for exactly where these values come from (Firebase console > Project
# settings > General > Your apps > Web app).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the backend API, no trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Public half of the VAPID key pair generated for the backend (see backend/.env.example) —
# needed by the browser to create a push subscription.
VITE_VAPID_PUBLIC_KEY=
